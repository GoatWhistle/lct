{
  "name": "lct-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/precompress-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && node scripts/check-kio-fields.mjs && node scripts/check-accessible-controls.mjs",
    "check:kio": "node scripts/check-kio-fields.mjs",
    "check:a11y": "node scripts/check-accessible-controls.mjs",
    "test:ws-outbox": "node scripts/test-ws-outbox.mjs",
    "test:dds-history": "node scripts/test-dds-history.mjs",
    "test:dds-ack": "node scripts/test-dds-ack.mjs",
    "test:session-report": "node scripts/test-session-report.mjs",
    "test:scenario-start": "node scripts/test-scenario-start.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "jssip": "^3.13.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
