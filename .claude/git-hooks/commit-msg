#!/usr/bin/env bash
# Сообщение коммита: формат `{type}: {desc}`, desc до 20 слов, без упоминаний ИИ-агентов
# и ссылок `#N`.
set -euo pipefail

msg_file=$1
here=$(dirname "$0")
stop=$(<"$here/stopwords")

# Комментарии git и вырезку под `-v` не проверяем — в коммит они не попадут.
msg=$(sed -e '/^# ------------------------ >8 ------------------------$/,$d' -e '/^#/d' "$msg_file")
subject=$(printf '%s\n' "$msg" | sed -n '/./{p;q;}')

case $subject in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

fail() { printf 'commit-msg: %s\n' "$1" >&2; exit 1; }

hit=$(printf '%s\n' "$msg" | grep -oiE "$stop" | head -1 || true)
[[ -z $hit ]] || fail "упоминание агента в сообщении: «$hit»"

# Issues перед сдачей удаляются, а в новом репо `#N` укажет на чужой PR — задачи по id карточки.
ref=$(printf '%s\n' "$msg" | grep -oE '(^|[^[:alnum:]&/])#[0-9]+' | head -1 || true)
[[ -z $ref ]] || fail "ссылка на issue/PR «${ref#?}» — вместо неё id карточки (lct-12)"

[[ $subject =~ ^(feat|fix|docs|chore|refactor|test|perf|lct-[0-9]+):\ (.+)$ ]] \
  || fail "заголовок не по формату \`{type}: {desc}\` (feat|fix|docs|chore|refactor|test|perf|lct-<id>): «$subject»"

words=$(printf '%s\n' "${BASH_REMATCH[2]}" | wc -w)
(( words <= 20 )) || fail "в описании $words слов, лимит 20"
