#!/usr/bin/env bash
# Добавленные строки не должны упоминать ИИ-агентов. Не проверяем: файлы, которые вырезаются
# из истории перед сдачей (scrub-history.sh), их строки в .gitignore, блоки между
# `scrub:start` / `scrub:end` (тоже вырезаются) и чужие материалы задачи.
set -euo pipefail

here=$(dirname "$0")
stop=$(<"$here/stopwords")

# Строки как «файл<TAB>номер<TAB>текст» по номерам новой версии файла.
added=$(git diff --cached -U0 --no-color --diff-filter=ACMR -- . \
    ':(exclude).claude/**' ':(exclude)CLAUDE.md' ':(exclude)AGENTS.md' \
    ':(exclude,glob)**/PROMPT-*' ':(exclude,glob)**/TASK-*' ':(exclude).agents/**' \
    ':(exclude)docs/task09-materials/**' ':(exclude).gitignore' \
  | awk '/^\+\+\+ /{f=substr($0,7); next}
         /^@@/{split($3,a,","); n=substr(a[1],2)+0; next}
         /^\+/{print f"\t"n"\t"substr($0,2); n++}')

hits=$(printf '%s\n' "$added" | grep -iE "$stop" || true)
[[ -n $hits ]] || exit 0

report=
while IFS=$'\t' read -r file line text; do
  # Номер строки внутри блока scrub в индексной версии файла — пропускаем.
  inside=$(git show ":$file" | awk -v t="$line" '
    /<!-- scrub:start -->/{s=1} NR==t{print s; exit} /<!-- scrub:end -->/{s=0}')
  [[ $inside == 1 ]] || report+="$file:$line: $text"$'\n'
done <<<"$hits"

if [[ -n $report ]]; then
  printf 'pre-commit: упоминание агента в добавленных строках:\n%s' "$report" >&2
  exit 1
fi
