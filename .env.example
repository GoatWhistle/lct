# Скопировать в .env. Файл в .gitignore: ключи в репозиторий не едут.
DATABASE_URL=postgresql+asyncpg://lct:lct@localhost:5432/lct

# LLM: провайдер меняется значением, не кодом (docs/arch/STACK.md)
LLM_PROVIDER=gigachat
LLM_API_KEY=
LLM_MODEL_CALLER=
LLM_MODEL_JUDGE=
JUDGE_TEMPERATURE=0

# Голосовой контур
MODELS_DIR=models
STT_MODEL=gigaam-v3-rnnt
ENDPOINTING_MS=600
OFFLINE=false
